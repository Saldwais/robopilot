<?xml version="1.0"?>
<sdf version="1.9">
  <world name="robopilot_test">
    <physics name="1ms" type="ignored"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="floor"><collision name="collision"><geometry><box><size>20 12 0.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>20 12 0.1</size></box></geometry><material><ambient>0.35 0.38 0.4 1</ambient></material></visual></link></model>
    <model name="lane_marking_left"><static>true</static><pose>0 0.8 0.006 0 0 0</pose><link name="stripe"><visual name="visual"><geometry><box><size>12 0.04 0.01</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient></material></visual></link></model>
    <model name="lane_marking_right"><static>true</static><pose>0 -0.8 0.006 0 0 0</pose><link name="stripe"><visual name="visual"><geometry><box><size>12 0.04 0.01</size></box></geometry><material><ambient>0.9 0.8 0.1 1</ambient></material></visual></link></model>
    <model name="obstacle"><static>true</static><pose>2 0 0.35 0 0 0</pose><link name="body"><collision name="collision"><geometry><box><size>0.5 0.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 0.5 0.7</size></box></geometry><material><ambient>0.7 0.15 0.1 1</ambient></material></visual></link></model>

    <model name="tree"><static>true</static><pose>1.2 2 0 0 0 0</pose><link name="trunk"><visual name="bark"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.8</length></cylinder></geometry><material><ambient>0.28 0.16 0.08 1</ambient></material></visual><collision name="trunk_col"><pose>0 0 0.9 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>1.8</length></cylinder></geometry></collision><visual name="crown"><pose>0 0 2.1 0 0 0</pose><geometry><sphere><radius>0.85</radius></sphere></geometry><material><ambient>0.1 0.4 0.15 1</ambient></material></visual><collision name="crown_col"><pose>0 0 2.1 0 0 0</pose><geometry><sphere><radius>0.8</radius></sphere></geometry></collision></link></model>
    <model name="person_proxy"><static>true</static><pose>3 1 0 0 0 0</pose><link name="body"><visual name="torso"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>0.8</length></cylinder></geometry><material><ambient>0.12 0.25 0.75 1</ambient></material></visual><visual name="head"><pose>0 0 1.55 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.75 0.58 0.42 1</ambient></material></visual><collision name="person_col"><pose>0 0 0.95 0 0 0</pose><geometry><cylinder><radius>0.22</radius><length>1.2</length></cylinder></geometry></collision></link></model>
    <model name="dog_proxy"><static>true</static><pose>4 -1 0.2 0 0 0</pose><link name="body"><visual name="visual"><geometry><box><size>0.65 0.28 0.38</size></box></geometry><material><ambient>0.55 0.3 0.12 1</ambient></material></visual><collision name="collision"><geometry><box><size>0.65 0.28 0.38</size></box></geometry></collision></link></model>
    <model name="sidewalk_steps"><static>true</static><pose>2.5 -2 0 0 0 0</pose><link name="steps"><visual name="step1"><pose>0 0 0.08 0 0 0</pose><geometry><box><size>1.2 0.7 0.16</size></box></geometry><material><ambient>0.5 0.5 0.52 1</ambient></material></visual><visual name="step2"><pose>0 0 0.24 0 0 0</pose><geometry><box><size>1.0 0.6 0.16</size></box></geometry><material><ambient>0.58 0.58 0.6 1</ambient></material></visual><visual name="step3"><pose>0 0 0.4 0 0 0</pose><geometry><box><size>0.8 0.5 0.16</size></box></geometry><material><ambient>0.64 0.64 0.66 1</ambient></material></visual><collision name="step_col"><pose>0 0 0.24 0 0 0</pose><geometry><box><size>1.2 0.7 0.48</size></box></geometry></collision></link></model>
  </world>
</sdf>
