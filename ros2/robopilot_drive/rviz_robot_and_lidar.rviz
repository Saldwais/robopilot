Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Plane: XY
      Cell Size: 1
      Color: 120; 120; 120
    - Class: rviz_default_plugins/RobotModel
      Name: Robot Exterior Model
      Enabled: true
      Description Source: Topic
      Description Topic: {Value: /robot_description}
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR Scan
      Enabled: true
      Topic: {Value: /scan, Reliability Policy: Best Effort}
      Size (m): 0.03
      Style: Points
      Color Transformer: Intensity
    - Class: rviz_default_plugins/Image
      Name: Camera Perception Overlay
      Enabled: true
      Topic: {Value: /perception/annotated}
  Global Options: {Fixed Frame: odom}
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current: {Class: rviz_default_plugins/Orbit, Distance: 4, Focal Point: 0; 0; 0}
