# Copy to a private file outside the repository; never commit real certs or keys.
AWS_IOT_ENDPOINT=your-endpoint-ats.iot.your-region.amazonaws.com
ROBOT_DEVICE_ID=robot-001
AWS_CA_FILE=/secure/path/AmazonRootCA1.pem
AWS_CERT_FILE=/secure/path/device-certificate.pem.crt
AWS_PRIVATE_KEY_FILE=/secure/path/private.pem.key
